{
  "name": "eduflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait postgres redis mailpit",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down --volumes && docker compose up -d --wait postgres redis mailpit",
    "db:generate": "pnpm --filter @eduflow/api db:generate",
    "db:migrate": "pnpm --filter @eduflow/api db:migrate",
    "db:deploy": "pnpm --filter @eduflow/api db:deploy",
    "db:seed": "pnpm --filter @eduflow/api db:seed",
    "db:reset": "pnpm --filter @eduflow/api db:reset"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.6"
  }
}
