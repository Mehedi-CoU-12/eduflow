# ShikkhaCore API configuration (copied to apps/api/.env by `pnpm setup`).
# Every variable is validated at startup by src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------------
# Normal requests: subject to row level security. Must NOT be the owner or a superuser.
DATABASE_URL=postgresql://shikkhacore_app:app_dev_password@127.0.0.1:5433/shikkhacore
# Trusted code paths only (auth, tenant resolution, platform admin, seeding).
SYSTEM_DATABASE_URL=postgresql://shikkhacore_system:system_dev_password@127.0.0.1:5433/shikkhacore
# Migrations only (Prisma CLI). Never given to the running API.
MIGRATION_DATABASE_URL=postgresql://shikkhacore_owner:owner_dev_password@127.0.0.1:5433/shikkhacore
DATABASE_POOL_MAX=10

# --- Redis (rate limiting, login throttling, BullMQ) ----------------------------------
REDIS_URL=redis://127.0.0.1:6380/0
QUEUE_PREFIX=shikkhacore
# Run BullMQ workers inside the API process. Production runs `node dist/worker.js` instead.
WORKER_ENABLED=true

# --- Hosts and tenant resolution --------------------------------------------------
# Canonical public URL of the account (root) host; used to build links in emails.
APP_PUBLIC_URL=http://localhost:3100
# Schools are served at <slug>.<APP_BASE_DOMAIN>.
APP_BASE_DOMAIN=localhost
# Comma-separated hostnames.
APP_ROOT_HOSTS=localhost
APP_PLATFORM_HOSTS=admin.localhost
# Express "trust proxy" setting. The web dev server proxies /api from localhost.
TRUST_PROXY=loopback
# Comma-separated extra origins allowed by CORS. Empty = same-origin only (recommended).
CORS_ORIGINS=

# --- Sessions ---------------------------------------------------------------------
# Use __Host-sc_session with COOKIE_SECURE=true in production.
SESSION_COOKIE_NAME=sc_session
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_HOURS=168

# --- Rate limiting ------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# --- Mail ---------------------------------------------------------------------------
# smtp | log | memory
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1026
MAIL_FROM=ShikkhaCore <no-reply@shikkhacore.local>

# --- Startup tasks ------------------------------------------------------------------
# Sync the permission catalog and system roles from @shikkhacore/types (additive only).
ACCESS_CONTROL_SYNC_ON_BOOT=true
