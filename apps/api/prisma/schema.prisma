// EduFlow database schema. See docs/database.md for the ERD and conventions.
//
// - Tables and columns are snake_case (@@map / @map); models are PascalCase.
// - Primary keys are UUIDv7 generated by PostgreSQL 18 (`uuidv7()`), so they sort by
//   creation time and index well.
// - Tenant-owned tables carry `school_id` and are protected by row level security.
//   RLS policies, grants, CHECK constraints and integrity triggers are written by hand
//   in the migration SQL because Prisma does not model them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Identity (global, not tenant-scoped)
// -----------------------------------------------------------------------------

enum UserStatus {
  active
  disabled
}

/// A person. Global across schools: one teacher can work at several schools.
model User {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stored lowercased (CHECK constraint).
  email           String     @unique
  name            String
  phone           String?
  avatarUrl       String?    @map("avatar_url")
  /// Preferred UI locale (BCP 47, e.g. "en", "bn"); falls back to the school default.
  locale          String?
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential         UserCredential?
  sessions           Session[]
  authTokens         AuthToken[]
  memberships        SchoolMembership[]
  platformMembership PlatformMembership?
  auditLogs          AuditLog[]

  @@map("users")
}

/// Password hash kept apart from `users` so profile queries can never leak it.
/// Only the system database role can read this table.
model UserCredential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  /// Hostname the session was created on. Requests from any other host are rejected.
  host           String
  /// Selected school when the session lives on the root (account) host.
  activeSchoolId String?   @map("active_school_id") @db.Uuid
  ipAddress      String?   @map("ip_address") @db.Inet
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason  String?   @map("revoked_reason")

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSchool School? @relation(fields: [activeSchoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenType {
  email_verification
  password_reset
}

/// Single-use email tokens (verification, password reset). Only the hash is stored.
model AuthToken {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// -----------------------------------------------------------------------------
// Access control
// -----------------------------------------------------------------------------

enum Realm {
  school
  platform
}

enum PermissionScope {
  own
  assigned
  all
}

/// Permission catalog, synced from @eduflow/types at startup.
model Permission {
  key         String            @id
  realm       Realm
  module      String
  description String
  /// Scopes this permission may be granted with.
  scopes      PermissionScope[]
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  grants RolePermission[]

  @@map("permissions")
}

/// System roles have `school_id = NULL` and a stable `key`; custom roles belong to one
/// school and have no key (CHECK constraint).
model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  realm       Realm
  key         String?  @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school              School?              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  grants              RolePermission[]
  membershipRoles     MembershipRole[]
  platformMemberships PlatformMembership[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("roles")
}

/// A permission granted to a role with a data scope.
model RolePermission {
  roleId        String          @map("role_id") @db.Uuid
  permissionKey String          @map("permission_key")
  scope         PermissionScope @default(all)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

enum SchoolStatus {
  active
  suspended
  archived
}

enum OnboardingStatus {
  not_started
  in_progress
  completed
}

/// The tenant. Every tenant-owned row references a school.
model School {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Subdomain label: <slug>.<APP_BASE_DOMAIN>.
  slug             String           @unique
  name             String
  status           SchoolStatus     @default(active)
  /// ISO 3166-1 alpha-2.
  countryCode      String           @default("BD") @map("country_code") @db.Char(2)
  /// IANA time zone.
  timezone         String           @default("Asia/Dhaka")
  /// ISO 4217. Money columns elsewhere store their own currency; this is the default.
  currencyCode     String           @default("BDT") @map("currency_code") @db.Char(3)
  defaultLocale    String           @default("en") @map("default_locale")
  onboardingStatus OnboardingStatus @default(not_started) @map("onboarding_status")
  email            String?
  phone            String?
  website          String?
  address          String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains     SchoolDomain[]
  memberships SchoolMembership[]
  roles       Role[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@map("schools")
}

/// Custom domains (e.g. portal.greenfield.edu.bd). Subdomains need no row.
model SchoolDomain {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  /// Lowercase hostname (CHECK constraint).
  domain     String    @unique
  /// Only verified domains resolve to the school.
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_domains")
}

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

/// A user's membership of a school. Memberships are never deleted, only moved to
/// `removed`, so history that references them stays intact.
model SchoolMembership {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  school School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles  MembershipRole[]

  @@unique([schoolId, userId])
  /// Target of the composite foreign key from membership_roles.
  @@unique([id, schoolId])
  @@index([userId])
  @@index([schoolId, status])
  @@map("school_memberships")
}

/// Roles held by a membership. A member can hold several roles (e.g. Teacher and
/// Parent/Guardian). `school_id` is denormalised for row level security and pinned
/// to the membership's school by a composite foreign key.
model MembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership SchoolMembership @relation(fields: [membershipId, schoolId], references: [id, schoolId], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([schoolId])
  @@index([roleId])
  @@map("membership_roles")
}

/// Platform staff (EduFlow operators). Separate from school memberships so that
/// platform access never comes from, or leaks into, a school context.
model PlatformMembership {
  userId    String           @id @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@map("platform_memberships")
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

/// Append-only audit trail (UPDATE/DELETE/TRUNCATE are blocked by triggers).
/// `school_id` is NULL for user- or platform-level events such as sign-in.
model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Dotted verb, e.g. "school.created", "membership.roles_updated".
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
