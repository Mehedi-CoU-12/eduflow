{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "EduFlow React library (source consumed by Next.js)",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true
  }
}
