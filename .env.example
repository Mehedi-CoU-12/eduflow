# Docker Compose settings for local infrastructure (copied to .env by `pnpm setup`).
# These values must match the connection strings in apps/api/.env.

POSTGRES_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=postgres

# Passwords for the three ShikkhaCore database roles (see docs/multi-tenancy.md).
SHIKKHACORE_OWNER_PASSWORD=owner_dev_password
SHIKKHACORE_APP_PASSWORD=app_dev_password
SHIKKHACORE_SYSTEM_PASSWORD=system_dev_password

REDIS_PORT=6380
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
